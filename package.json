{
  "name": "englishquest",
  "private": true,
  "version": "2.0.0",
  "packageManager": "pnpm@11.19.0",
  "workspaces": ["apps/*"],
  "scripts": {
    "dev": "pnpm --parallel --filter ./apps/* dev",
    "build": "pnpm --recursive build",
    "typecheck": "pnpm --recursive typecheck",
    "db:generate": "pnpm --filter @englishquest/api prisma:generate",
    "db:migrate": "pnpm --filter @englishquest/api prisma:migrate"
  }
}
